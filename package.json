{
  "name": "dsh-task-center",
  "version": "1.22.0",
  "private": true,
  "type": "module",
  "description": "Kanban task center for DeepSeek Harness: a four-column Web panel plus agent tools for managing tasks.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "harness",
    "plugin",
    "bundle",
    "task",
    "todo",
    "kanban",
    "web-ui"
  ],
  "homepage": "https://github.com/Mashiro707/dsh-task-center#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mashiro707/dsh-task-center.git"
  },
  "bugs": {
    "url": "https://github.com/Mashiro707/dsh-task-center/issues"
  },
  "author": "Mashiro",
  "license": "Apache-2.0",
  "icon": "icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "npm run build && node --test test/store.test.mjs test/client-ui.test.mjs test/runner.test.mjs test/remote.test.mjs test/stage-doc.test.mjs test/worktree.test.mjs test/browser.test.mjs",
    "test:browser": "node test/live-browser.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./runner": "./runner.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./stages": "./stages.js",
    "./verify": "./verify.js",
    "./remote": "./remote.js"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "index.js",
    "locale/*.json",
    "remote.js",
    "runner.js",
    "src",
    "stages.js",
    "tsconfig.client.json",
    "tsconfig.host.json",
    "verify.js",
    "worktree.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "playwright-core": "1.49",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.3"
  }
}
