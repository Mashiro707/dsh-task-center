{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": ".",
    "noEmitOnError": true,
    "declaration": false,
    "sourceMap": false,
    "removeComments": false
  },
  "include": ["src/index.ts", "src/types.d.ts", "src/host-globals.d.ts"],
  "exclude": ["node_modules", "test", "locale"]
}
