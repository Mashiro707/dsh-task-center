{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "legacy",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": ".",
    "noEmitOnError": true,
    "declaration": false,
    "sourceMap": false,
    "removeComments": false
  },
  "include": ["src/client.ts", "src/types.d.ts", "src/client-globals.d.ts"],
  "exclude": ["node_modules", "test", "locale"]
}
